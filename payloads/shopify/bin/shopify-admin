#!/usr/bin/env node
/**
 * shopify-admin — multi-client Shopify Admin API CLI for OpenClaw agents.
 *
 * Zero dependencies (node >= 18, uses global fetch).
 *
 * Store registry : /data/.openclaw/credentials/shopify/stores.json   (non-secret)
 * Tokens         : /data/.openclaw/credentials/shopify/tokens.env    (chmod 600)
 *
 * Tokens are never printed. All output is redacted for shp*_ patterns before
 * it reaches stdout/stderr.
 */

'use strict';

const fs = require('fs');
const path = require('path');

const CRED_DIR =
  process.env.SHOPIFY_CRED_DIR || '/data/.openclaw/credentials/shopify';
const STORES_FILE =
  process.env.SHOPIFY_STORES_CONFIG || path.join(CRED_DIR, 'stores.json');
const TOKENS_FILE =
  process.env.SHOPIFY_TOKENS_ENV || path.join(CRED_DIR, 'tokens.env');

const DEFAULT_API_VERSION = '2025-04';
const MAX_RETRIES = 5;

// ---------------------------------------------------------------- redaction

const SECRET_RE = /\bshp(?:at|ca|pa|ss)_[A-Za-z0-9]+/g;

function redact(s) {
  return String(s).replace(SECRET_RE, 'shp***_[redacted]');
}
function out(s) {
  process.stdout.write(redact(s) + '\n');
}
function err(s) {
  process.stderr.write(redact(s) + '\n');
}
function die(msg, code = 1) {
  err('error: ' + msg);
  process.exit(code);
}

// ------------------------------------------------------------------ config

function loadStores() {
  if (!fs.existsSync(STORES_FILE)) {
    die(
      `no store registry at ${STORES_FILE}\n` +
        `       run: shopify-admin add-store --help`
    );
  }
  let cfg;
  try {
    cfg = JSON.parse(fs.readFileSync(STORES_FILE, 'utf8'));
  } catch (e) {
    die(`store registry is not valid JSON (${STORES_FILE}): ${e.message}`);
  }
  if (!cfg.stores || typeof cfg.stores !== 'object') {
    die(`store registry has no "stores" object (${STORES_FILE})`);
  }
  return cfg;
}

function loadTokens() {
  const tokens = {};
  if (fs.existsSync(TOKENS_FILE)) {
    for (const raw of fs.readFileSync(TOKENS_FILE, 'utf8').split('\n')) {
      const line = raw.trim();
      if (!line || line.startsWith('#')) continue;
      const i = line.indexOf('=');
      if (i === -1) continue;
      tokens[line.slice(0, i).trim()] = line
        .slice(i + 1)
        .trim()
        .replace(/^["']|["']$/g, '');
    }
  }
  return tokens;
}

function resolveStore(slug) {
  const cfg = loadStores();
  const key = String(slug || '').toLowerCase();
  const store = cfg.stores[key];
  if (!store) {
    const known = Object.keys(cfg.stores).sort().join(', ') || '(none)';
    die(`unknown store "${slug}". Configured stores: ${known}`);
  }
  const tokens = loadTokens();
  const envName = store.token_env || `SHOPIFY_TOKEN_${key.toUpperCase()}`;
  const token = process.env[envName] || tokens[envName];
  if (!token) {
    die(
      `no access token for "${key}" — expected ${envName} in ${TOKENS_FILE} ` +
        `or the environment`
    );
  }
  if (!store.domain) die(`store "${key}" has no "domain" in the registry`);
  return {
    slug: key,
    ...store,
    token,
    api_version: store.api_version || cfg.default_api_version || DEFAULT_API_VERSION,
  };
}

// ------------------------------------------------------------------- HTTP

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function request(store, { url, method = 'POST', body }) {
  let attempt = 0;
  for (;;) {
    attempt++;
    let res;
    try {
      res = await fetch(url, {
        method,
        headers: {
          'X-Shopify-Access-Token': store.token,
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
    } catch (e) {
      if (attempt > MAX_RETRIES) die(`network failure: ${e.message}`);
      await sleep(1000 * attempt);
      continue;
    }

    const text = await res.text();
    let json = null;
    try {
      json = text ? JSON.parse(text) : null;
    } catch {
      /* non-JSON body — handled below */
    }

    // Rate limiting: HTTP 429, or a GraphQL THROTTLED extension.
    const throttled =
      res.status === 429 ||
      (json &&
        Array.isArray(json.errors) &&
        json.errors.some(
          (e) => e && e.extensions && e.extensions.code === 'THROTTLED'
        ));

    if (throttled) {
      if (attempt > MAX_RETRIES) die('throttled by Shopify after retries');
      const retryAfter = Number(res.headers.get('retry-after'));
      const wait = Number.isFinite(retryAfter) && retryAfter > 0
        ? retryAfter * 1000
        : 2000 * attempt;
      err(`[throttled] waiting ${wait}ms (attempt ${attempt}/${MAX_RETRIES})`);
      await sleep(wait);
      continue;
    }

    if (res.status >= 500) {
      if (attempt > MAX_RETRIES) die(`Shopify ${res.status}: ${text.slice(0, 400)}`);
      await sleep(1000 * attempt);
      continue;
    }

    if (res.status === 401 || res.status === 403) {
      die(
        `Shopify ${res.status} for "${store.slug}" — the token is invalid, ` +
          `revoked, or missing the scope for this resource.`
      );
    }

    if (!res.ok) {
      die(`Shopify ${res.status}: ${text.slice(0, 800)}`);
    }

    if (json === null) die(`non-JSON response from Shopify: ${text.slice(0, 400)}`);
    return json;
  }
}

function gqlUrl(store) {
  return `https://${store.domain}/admin/api/${store.api_version}/graphql.json`;
}

async function gql(store, query, variables) {
  const json = await request(store, {
    url: gqlUrl(store),
    body: { query, variables: variables || {} },
  });
  if (json.errors && json.errors.length) {
    const denied = json.errors.some(
      (e) => e && e.extensions && e.extensions.code === 'ACCESS_DENIED'
    );
    err(JSON.stringify(json.errors, null, 2));
    die(
      denied
        ? `ACCESS_DENIED for "${store.slug}" — this token does not hold the ` +
            `required scope. Ask the store owner to add it to the app, then re-mint.`
        : 'GraphQL errors (above)'
    );
  }
  return json.data;
}

// --------------------------------------------------------------- utilities

function dig(obj, dotted) {
  return dotted
    .split('.')
    .filter(Boolean)
    .reduce((o, k) => (o == null ? o : o[k]), obj);
}

function readQueryArg(arg) {
  if (!arg) die('missing GraphQL query (pass a string, a @file path, or - for stdin)');
  if (arg === '-') return fs.readFileSync(0, 'utf8');
  if (arg.startsWith('@')) return fs.readFileSync(arg.slice(1), 'utf8');
  return arg;
}

function parseFlags(argv) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      if (eq !== -1) flags[a.slice(2, eq)] = a.slice(eq + 1);
      else if (argv[i + 1] !== undefined && !argv[i + 1].startsWith('--'))
        flags[a.slice(2)] = argv[++i];
      else flags[a.slice(2)] = true;
    } else rest.push(a);
  }
  return { flags, rest };
}

// ---------------------------------------------------------------- commands

const USAGE = `shopify-admin — Shopify Admin API access for OpenClaw agents

USAGE
  shopify-admin stores
  shopify-admin whoami <store>
  shopify-admin scopes <store>
  shopify-admin gql <store> <query|@file|-> [--vars '<json>']
  shopify-admin paginate <store> <query|@file|-> --path <a.b.c> [--page-size 250] [--max N]
  shopify-admin rest <store> <METHOD> <path> [body-json]

EXAMPLES
  shopify-admin stores
  shopify-admin whoami bazaa
  shopify-admin gql bazaa '{ productsCount(query:"status:active"){ count } }'
  shopify-admin gql bazaa @/data/.openclaw/skills/shopify/reference/q.graphql --vars '{"n":5}'
  shopify-admin paginate bazaa @q.graphql --path products --max 1000

NOTES
  <store> is a slug from the registry (shopify-admin stores).
  paginate: your query MUST take $cursor: String and $n: Int and pass them to
  the connection as (first: $n, after: $cursor), and select
  pageInfo { hasNextPage endCursor }. Output is a JSON array of nodes.
  Tokens are never printed; output is redacted.`;

async function cmdStores() {
  const cfg = loadStores();
  const tokens = loadTokens();
  const rows = Object.entries(cfg.stores).map(([slug, s]) => {
    const envName = s.token_env || `SHOPIFY_TOKEN_${slug.toUpperCase()}`;
    return {
      slug,
      label: s.label || slug,
      domain: s.domain,
      storefront: s.storefront || null,
      api_version: s.api_version || cfg.default_api_version || DEFAULT_API_VERSION,
      token_present: Boolean(process.env[envName] || tokens[envName]),
      scopes: s.scopes || [],
    };
  });
  out(JSON.stringify(rows, null, 2));
}

async function cmdWhoami(slug) {
  const store = resolveStore(slug);
  const data = await gql(
    store,
    `{ shop { name myshopifyDomain primaryDomain { host } currencyCode ianaTimezone }
       productsCount(query: "status:active") { count } }`
  );
  out(
    JSON.stringify(
      {
        store: store.slug,
        label: store.label || store.slug,
        api_version: store.api_version,
        ...data,
      },
      null,
      2
    )
  );
}

async function cmdScopes(slug) {
  const store = resolveStore(slug);
  const data = await gql(
    store,
    `{ currentAppInstallation { accessScopes { handle } } }`
  );
  const granted = (
    dig(data, 'currentAppInstallation.accessScopes') || []
  ).map((s) => s.handle);
  out(
    JSON.stringify(
      { store: store.slug, granted: granted.sort(), declared: store.scopes || [] },
      null,
      2
    )
  );
}

async function cmdGql(slug, queryArg, flags) {
  const store = resolveStore(slug);
  const query = readQueryArg(queryArg);
  let variables = {};
  if (flags.vars) {
    try {
      variables = JSON.parse(flags.vars);
    } catch (e) {
      die(`--vars is not valid JSON: ${e.message}`);
    }
  }
  const data = await gql(store, query, variables);
  out(JSON.stringify(data, null, 2));
}

async function cmdPaginate(slug, queryArg, flags) {
  const store = resolveStore(slug);
  const query = readQueryArg(queryArg);
  const connPath = flags.path;
  if (!connPath) die('paginate requires --path <dotted.path.to.connection>');

  const pageSize = Math.min(Number(flags['page-size']) || 250, 250);
  const max = Number(flags.max) || Infinity;
  let variables = {};
  if (flags.vars) {
    try {
      variables = JSON.parse(flags.vars);
    } catch (e) {
      die(`--vars is not valid JSON: ${e.message}`);
    }
  }

  const nodes = [];
  let cursor = null;
  let page = 0;

  for (;;) {
    page++;
    const data = await gql(store, query, {
      ...variables,
      n: pageSize,
      cursor,
    });
    const conn = dig(data, connPath);
    if (!conn) die(`--path "${connPath}" not found in the response`);

    const batch = conn.nodes || (conn.edges || []).map((e) => e.node);
    if (!Array.isArray(batch)) {
      die(`connection at "${connPath}" has neither nodes nor edges`);
    }
    for (const n of batch) {
      if (nodes.length >= max) break;
      nodes.push(n);
    }

    const info = conn.pageInfo;
    if (!info) die(`connection at "${connPath}" is missing pageInfo`);
    err(`[page ${page}] +${batch.length} (total ${nodes.length})`);

    if (!info.hasNextPage || nodes.length >= max) break;
    cursor = info.endCursor;
    await sleep(250); // stay well inside the leaky bucket
  }

  out(JSON.stringify(nodes, null, 2));
}

async function cmdRest(slug, method, apiPath, bodyArg) {
  const store = resolveStore(slug);
  if (!method || !apiPath) die('rest requires <METHOD> <path>');
  const clean = apiPath.replace(/^\/+/, '');
  const url = `https://${store.domain}/admin/api/${store.api_version}/${clean}`;
  let body;
  if (bodyArg) {
    try {
      body = JSON.parse(bodyArg);
    } catch (e) {
      die(`REST body is not valid JSON: ${e.message}`);
    }
  }
  const json = await request(store, {
    url,
    method: method.toUpperCase(),
    body,
  });
  out(JSON.stringify(json, null, 2));
}

// -------------------------------------------------------------------- main

async function main() {
  const argv = process.argv.slice(2);
  const { flags, rest } = parseFlags(argv);
  const cmd = rest[0];

  if (!cmd || cmd === 'help' || flags.help) {
    out(USAGE);
    return;
  }

  switch (cmd) {
    case 'stores':
      return cmdStores();
    case 'whoami':
      return cmdWhoami(rest[1]);
    case 'scopes':
      return cmdScopes(rest[1]);
    case 'gql':
      return cmdGql(rest[1], rest[2], flags);
    case 'paginate':
      return cmdPaginate(rest[1], rest[2], flags);
    case 'rest':
      return cmdRest(rest[1], rest[2], rest[3], rest[4]);
    default:
      die(`unknown command "${cmd}"\n\n${USAGE}`);
  }
}

main().catch((e) => die(e && e.stack ? e.stack : String(e)));
